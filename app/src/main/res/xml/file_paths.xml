<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Thư mục lưu trữ tệp giáo án nội bộ an toàn và offline -->
    <files-path name="lesson_attachments" path="lesson_attachments/" />
    <!-- Thư mục lưu trữ tệp tài liệu pháp quy và tri thức đối chiếu RAG -->
    <files-path name="knowledge_docs" path="knowledge_docs/" />
    <!-- Thư mục xuất văn bản sư phạm -->
    <files-path name="exported_docs" path="exported_docs/" />
    <cache-path name="exported_cache_docs" path="exported_docs/" />
    <!-- Hỗ trợ chia sẻ file trong filesDir -->
    <files-path name="app_files" path="." />
    <!-- Hỗ trợ chia sẻ file tạm trong cacheDir -->
    <cache-path name="app_cache" path="." />
</paths>
