{
  "name": "smart-teacher-schedule-desktop",
  "productName": "Smart Teacher Schedule AI",
  "version": "1.6.0",
  "description": "Trợ lý Lịch Giảng Dạy và Quản Lý Sư Phạm Đa Nền Tảng (Windows, Mac, Linux)",
  "main": "main.js",
  "author": "Huy Technology AI <huytechnologyai2025@gmail.com>",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.smartteacher.schedule.desktop",
    "productName": "Smart Teacher Schedule AI",
    "copyright": "Copyright © 2026 Huy Technology AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Teacher Schedule AI"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "icon.icns"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}